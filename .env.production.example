# ==============================================================================
# LogMate (로그메이트) 프로덕션 환경 설정 템플릿
# 복사하여 .env.production 파일로 저장하여 사용하세요: cp .env.production.example .env.production
# ==============================================================================

# 기본 서버 설정
NODE_ENV=production
PORT=3000

# 서비스 접속 도메인 (소셜 로그인 및 메타태그용)
NEXT_PUBLIC_APP_URL=https://logmate.yourdomain.com

# 1. 자체 구축 AI 엔진 설정 (Docker Compose 사용 시 기본값 http://ai:11434)
OLLAMA_HOST=http://ai:11434
LOCAL_EMBED_MODEL=all-minilm
LOCAL_LLM_MODEL=qwen2.5:1.5b

# 2. 클라우드 Gemini 하이브리드 백업 (선택 사항: 로컬 AI 부하 시 자동 폴백)
GEMINI_API_KEY=

# 3. Supabase 연동 (선택 사항: 파일 DB 대신 Supabase 클라우드 DB 사용 시)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
